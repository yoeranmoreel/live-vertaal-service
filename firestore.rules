rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }

    function isSchoolMember(schoolId) {
      return signedIn() && exists(memberPath(schoolId));
    }

    function memberRole(schoolId) {
      return get(memberPath(schoolId)).data.role;
    }

    function canManageSchool(schoolId) {
      return isSchoolMember(schoolId) && memberRole(schoolId) in ['teacher', 'schoolAdmin'];
    }

    match /schools/{schoolId} {
      allow read: if isSchoolMember(schoolId);
      allow write: if isSchoolMember(schoolId) && memberRole(schoolId) == 'schoolAdmin';

      match /members/{memberId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolMember(schoolId) && memberRole(schoolId) == 'schoolAdmin';
      }

      match /groups/{groupId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isSchoolMember(schoolId) && memberRole(schoolId) == 'schoolAdmin';
      }

      match /sessions/{sessionId} {
        allow read, create, update: if canManageSchool(schoolId);
        allow delete: if isSchoolMember(schoolId) && memberRole(schoolId) == 'schoolAdmin';

        match /{document=**} {
          allow read, write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
